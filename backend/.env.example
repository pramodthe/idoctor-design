# iDoctor Design secrets — never commit real keys
#   cp backend/.env.example backend/.env
# .env is gitignored. This file is the committed template.

# --- Claude (critic / experiment prose) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Paperclip (literature) ---
# Live evidence agent loads tools from Paperclip MCP into LangGraph.
PAPERCLIP_API_KEY=
PAPERCLIP_MCP_URL=https://paperclip.gxl.ai/mcp
# Optional: CLI/SDK fallback + local Paperclip server
PAPERCLIP_BASE_URL=

# --- Tamarind (fold/complex + BindCraft validate-job / submit) ---
TAMARIND_API_KEY=

# Modal / Proto leftover — not the live designer. Keep USE_PROTO=0.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
USE_PROTO=0

# Benchling: ignored — Monday card is markdown only (backend/agents/experiment.py).

IDOCTOR_DESIGN_LIVE_DESIGN=0
# Stage walkthrough: replay a saved run (demo-data banner on).
# live = partner calls; fixture = bundled JSON; replay = latest data/runs/* with no partners.
IDOCTOR_DESIGN_DEFAULT_MODE=replay
DEFAULT_PDB_ID=6OIM

# Bounded autonomous verification loop.
IDOCTOR_MAX_DESIGN_ITERATIONS=3
IDOCTOR_MAX_NO_IMPROVEMENT_ROUNDS=2
IDOCTOR_MIN_IPTM=0.75
IDOCTOR_MAX_COMPLEX_DESIGNS=1
IDOCTOR_MAX_COMPLEX_MUTANTS=2
IDOCTOR_COMPLEX_EVALUATION_TIMEOUT=1800
